---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="DisGame2Hard">
  <section class="hero">
    <h1>DisGame2Hard</h1>
    <p class="tagline">2hard's personal website</p>

    <div class="construction">
      <span class="icon">🚧</span>
      <p class="status">施工中</p>
      <p class="sub">網站改版中</p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 4rem 0;
  }
  h1 {
    margin: 0;
    font-size: 2.5rem;
    letter-spacing: 0.02em;
  }
  .tagline {
    margin: 0.5rem 0 0;
    color: var(--muted);
  }
  .construction {
    margin-top: 3.5rem;
    padding: 2rem 2.5rem;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .icon {
    font-size: 2.5rem;
    line-height: 1;
  }
  .status {
    margin: 0.75rem 0 0;
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--accent);
  }
  .sub {
    margin: 0.25rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
